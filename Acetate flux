%% COBRA script: Substrate uptake & acetate secretion (fixed OUR)
% Requires COBRA Toolbox + iJO1366 model

initCobraToolbox(false)


%% Load model
model = readCbModel('iJO1366.mat');

%% Define induction strategies with realistic substrate uptake
strategies = {'L','LG','IG'};
substrates = {
    [-10, -5,   0];    % L: glucose + lactose
    [  0, -5, -12];    % LG: lactose + glycerol
    [  0,  0, -12];    % IG: glycerol only
};
% Indices: {Glucose, Lactose, Glycerol}

%% Fixed OUR (oxygen uptake rate)
OUR = -10;  % mmol/gDW/h

%% Results table
results = table('Size',[0 7],...
    'VariableTypes',{'string','double','double','double','double','double','double'},...
    'VariableNames',{'Condition','Biomass','GlucoseUptake','LactoseUptake','GlycerolUptake','OxygenUptake','AcetateSecretion'});

%% Loop over strategies
for i = 1:length(strategies)
    cond = strategies{i};
    uptake = substrates{i};
    
    tempModel = model;
    
    % Reset substrate bounds
    tempModel = changeRxnBounds(tempModel,'EX_glc__D_e',0,'b');
    tempModel = changeRxnBounds(tempModel,'EX_lac__D_e',0,'b');
    tempModel = changeRxnBounds(tempModel,'EX_glyc_e',0,'b');
    tempModel = changeRxnBounds(tempModel,'EX_o2_e',0,'b');
    
    % Apply uptake constraints
    tempModel = changeRxnBounds(tempModel,'EX_glc__D_e',uptake(1),'l');
    tempModel = changeRxnBounds(tempModel,'EX_lac__D_e',uptake(2),'l');
    tempModel = changeRxnBounds(tempModel,'EX_glyc_e',uptake(3),'l');
    tempModel = changeRxnBounds(tempModel,'EX_o2_e',OUR,'l');
    
    % Optimize for biomass
    modelBiomass = changeObjective(tempModel,'BIOMASS_Ec_iJO1366_core_53p95M');
    FBAres = optimizeCbModel(modelBiomass,'max');
    
    % Extract acetate secretion
    acetateFlux = FBAres.x(strcmp(model.rxns,'EX_ac_e'));
    
    % Save results
    results = [results; {cond, FBAres.f, uptake(1), uptake(2), uptake(3), OUR, acetateFlux}];
end

%% Display results
disp('--- Substrate uptake & acetate secretion (OUR = -10) ---');
disp(results);
